---
import { business } from "@/data/business";
import Icon from "./Icon.astro";
---

<footer class="site-footer">
  <div class="container-main">
    <div class="footer-main">
      <div class="footer-intro">
        <a class="brand" href="/"
          ><span>Multifamily<span>Rehab Specialists</span></span></a
        >
        <p>
          Apartment renovations.<br />Houston and the communities around it.
        </p>
        <a
          class="footer-phone"
          href={business.phoneHref}
          data-call-source="footer">{business.phone}<Icon /></a
        >
        <a class="footer-email" href={`mailto:${business.email}`}
          >{business.email}</a
        >
      </div>
      <div>
        <h2>What we do</h2><ul>
          <li>
            <a href="/services/unit-interior-renovation">Apartment interiors</a>
          </li>
          <li><a href="/services/full-gut-rehab">Full gut rehabs</a></li>
          <li>
            <a href="/services/common-area-amenity-renovation"
              >Common areas &amp; amenities</a>
          </li>
          <li>
            <a href="/services/exterior-curb-appeal">Exterior improvements</a>
          </li>
          <li>
            <a href="/services/value-add-programs"
              >Phased renovation programs</a>
          </li>
        </ul>
      </div>
      <div>
        <h2>Around the site</h2><ul>
          <li><a href="/about">Our approach</a></li><li>
            <a href="/projects">Renovation scope ideas</a>
          </li>
          <li><a href="/service-areas">Greater Houston service areas</a></li><li
          >
            <a href="/blog">Renovation planning guide</a>
          </li><li><a href="/contact">Talk about your property</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {new Date().getFullYear()} {business.name}</span><span
        >Houston, Texas</span>
    </div>
  </div>
</footer>
<div class="mobile-call-bar">
  <a href={business.phoneHref} data-call-source="mobile-bar"
    ><Icon name="phone" /><span
      >Call about your property <strong>{business.phone}</strong></span
    ><Icon /></a>
</div>
