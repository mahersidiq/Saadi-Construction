---
import { serviceAreas } from "@/data/serviceAreas";
import Icon from "@/components/Icon.astro";
---

<section class="areas-section section-padding">
  <div class="container-main areas-grid">
    <div>
      <p class="eyebrow"><Icon name="pin" /> Our part of Texas</p><h2>
        Houston.<br />And a little<br /><em>further out.</em>
      </h2><p>
        Working on an apartment property in Greater Houston? Let’s talk about
        the location and the scope.
      </p><a class="text-link" href="/service-areas"
        >Explore our service areas<Icon /></a>
    </div>
    <div class="area-link-grid">
      {
        serviceAreas.slice(0, 12).map((area) => (
          <a href={`/service-areas/${area.slug}`}>
            {area.name}
            <Icon />
          </a>
        ))
      }
    </div>
  </div>
</section>
