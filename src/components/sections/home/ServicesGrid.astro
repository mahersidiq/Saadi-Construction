---
import { Image } from "astro:assets";
import kitchen from "@/assets/images/saadi-kitchen-renovation-houston-1.jpg";
import framing from "@/assets/images/saadi-multifamily-framing-houston-1.jpg";
import clubhouse from "@/assets/images/saadi-clubhouse-renovation-houston-1.jpg";
import Icon from "@/components/Icon.astro";
const services = [
  {
    num: "01",
    title: "Make the unit work harder.",
    label: "Apartment interiors",
    image: kitchen,
    alt: "Kitchen cabinetry and island finish reference",
    text: "Kitchens, bathrooms, flooring, paint, and the repairs that need to happen before the next resident moves in.",
    href: "/services/unit-interior-renovation",
    link: "Unit interior renovation",
  },
  {
    num: "02",
    title: "Start with what’s underneath.",
    label: "Full gut rehabs",
    image: framing,
    alt: "Exposed wood framing during building construction",
    text: "When a surface refresh won’t solve it: demolition, repairs, trade coordination, and a complete interior rebuild.",
    href: "/services/full-gut-rehab",
    link: "Full gut rehab",
  },
  {
    num: "03",
    title: "Look beyond the front door.",
    label: "Property-wide improvements",
    image: clubhouse,
    alt: "Shared lounge with seating and high ceilings",
    text: "Clubhouses, leasing spaces, amenities, and exterior improvements. Plan the shared spaces along with the units.",
    href: "/services/common-area-amenity-renovation",
    link: "Common areas & amenities",
  },
];
---

<section class="section-padding services-section" id="services">
  <div class="container-main">
    <div class="section-heading">
      <div>
        <p class="eyebrow">What needs work?</p><h2>
          The right scope.<br />Not just a longer punch list.
        </h2>
      </div><p>
        Keep what works. Replace what doesn’t.<br />Start with the part of your
        property that needs attention.
      </p>
    </div>
    <div class="service-card-grid">
      {
        services.map((service) => (
          <a href={service.href} class="service-card">
            <div class="service-card-image">
              <>
                <Image
                  src={service.image}
                  alt={service.alt}
                  widths={[360, 560, 800]}
                  sizes="(max-width: 767px) 92vw, 30vw"
                  format="webp"
                  loading="lazy"
                />
                <span>
                  {service.num} / {service.label}
                </span>
              </>
            </div>
            <div class="service-card-copy">
              <>
                <h3>{service.title}</h3>
                <p>{service.text}</p>
                <span class="text-link">
                  {service.link}
                  <Icon />
                </span>
              </>
            </div>
          </a>
        ))
      }
    </div>
    <div class="service-bottom">
      <span>Planning several phases or managing a larger renovation?</span><a
        href="/services"
        class="text-link">See all renovation services<Icon /></a>
    </div>
  </div>
</section>
