---
import { business } from "@/data/business";
import Icon from "@/components/Icon.astro";
---

<section class="contact-cta">
  <div class="container-main cta-grid">
    <div>
      <p class="eyebrow">Let’s talk about your property</p><h2>
        What’s on<br /><em>your punch list?</em>
      </h2><p>
        A unit turn, a bigger rehab, or a scope you’re still figuring out.<br
        />Start with a call. We’ll take it from there.
      </p>
    </div>
    <div class="cta-actions">
      <a class="cta-phone" href={business.phoneHref} data-call-source="page-cta"
        ><Icon name="phone" />{business.phone}<Icon /></a
      ><span>Prefer to write it down?</span><a
        class="text-link"
        href="/contact#project-inquiry">Send your project details<Icon /></a>
    </div>
  </div>
</section>
