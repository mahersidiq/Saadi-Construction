---
import { Image } from "astro:assets";
import kitchen from "@/assets/images/saadi-kitchen-renovation-houston-1.jpg";
import Icon from "@/components/Icon.astro";
import { business } from "@/data/business";
---

<section class="home-hero">
  <div class="container-main hero-grid">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="status-dot"></span> Multifamily renovation · Houston, TX
      </p>
      <h1>Apartment<br />renovations.<br /><em>Let’s get to work.</em></h1>
      <p class="hero-description">
        Your next unit turn. A full rehab. A property that needs a fresh start.
        We help apartment owners and managers turn a list of repairs into a
        clear renovation plan.
      </p>
      <a
        href={business.phoneHref}
        class="btn-primary hero-call"
        data-call-source="hero"
        ><Icon name="phone" />Call {business.phone}<Icon /></a
      >
      <a href="/services" class="text-link hero-secondary"
        >Find the right scope for your property<Icon /></a
      >
      <div class="hero-note">
        <span class="note-rule"></span><p>
          Kitchens &amp; baths. Interiors &amp; exteriors.<br /><strong
            >One property. One practical plan.</strong>
        </p>
      </div>
    </div>
    <figure class="hero-visual">
      <Image
        src={kitchen}
        alt="Apartment kitchen with dark cabinets, an island, and wood-look flooring"
        widths={[480, 720, 1080]}
        sizes="(max-width: 767px) 100vw, 48vw"
        format="webp"
        loading="eager"
        fetchpriority="high"
        class="hero-photo"
      />
      <div class="hero-image-tag">
        <Icon class="tag-mark" /><span
          >Apartments are your business.<br /><strong
            >Renovating them is ours.</strong
          ></span>
      </div>
      <figcaption>
        <span>Interiors · Full rehabs · Community spaces</span><span
          >Greater Houston</span>
      </figcaption>
    </figure>
  </div>
</section>
