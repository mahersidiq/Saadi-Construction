---
import { business } from "@/data/business";
import Icon from "./Icon.astro";
const links = [
  ["Services", "/services"],
  ["Our approach", "/about"],
  ["Service areas", "/service-areas"],
  ["Contact", "/contact"],
];
const active = (href) => Astro.url.pathname.startsWith(href);
---

<div class="utility-bar">
  <div class="container-main utility-inner">
    <span
      ><span class="status-dot"></span> Houston &amp; surrounding communities</span
    ><span class="utility-audience"
      >For apartment owners &amp; property managers</span>
  </div>
</div>
<header class="site-header">
  <div class="container-main header-inner">
    <a href="/" class="brand" aria-label={`${business.name} — home`}>
      <svg
        class="brand-mark"
        width="38"
        height="40"
        viewBox="0 0 38 40"
        fill="none"
        aria-hidden="true"
        ><path
          d="M2 36V14L13 5v31M13 36V14l11-9v31M24 36V14l11-9v31M2 37h34"
          stroke="currentColor"
          stroke-width="2.5"></path></svg
      >
      <span>Multifamily<span>Rehab Specialists</span></span>
    </a>
    <nav class="desktop-nav" aria-label="Main navigation">
      {
        links.map(([label, href]) => (
          <a href={href} aria-current={active(href) ? "page" : undefined}>
            {label}
          </a>
        ))
      }
    </nav>
    <a
      class="header-call"
      href={business.phoneHref}
      aria-label={`Call ${business.phone}`}
      data-call-source="header"
      ><Icon name="phone" /><span>{business.phone}</span></a
    >
    <button
      class="menu-toggle"
      type="button"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="mobile-navigation"><span></span><span></span></button
    >
  </div>
  <nav
    id="mobile-navigation"
    class="mobile-navigation"
    aria-label="Mobile navigation"
    hidden
  >
    <div class="container-main">
      {
        links.map(([label, href]) => (
          <a href={href} aria-current={active(href) ? "page" : undefined}>
            {label}
            <Icon />
          </a>
        ))
      }
      <a href="/blog">Renovation planning guide<Icon /></a>
      <a class="mobile-menu-call" href={business.phoneHref}
        ><Icon name="phone" />{business.phone}</a
      >
    </div>
  </nav>
  <noscript
    ><nav
      class="no-js-navigation container-main"
      aria-label="Navigation without JavaScript"
    >
      {links.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav></noscript
  >
</header>
<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const menu = document.querySelector<HTMLElement>("#mobile-navigation");
  function closeMenu() {
    toggle?.setAttribute("aria-expanded", "false");
    toggle?.setAttribute("aria-label", "Open menu");
    if (menu) menu.hidden = true;
  }
  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") !== "true";
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Close menu" : "Open menu");
    if (menu) menu.hidden = !open;
  });
  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && menu && !menu.hidden) {
      closeMenu();
      toggle?.focus();
    }
  });
  menu
    ?.querySelectorAll("a")
    .forEach((link) => link.addEventListener("click", closeMenu));
  window
    .matchMedia("(min-width: 1100px)")
    .addEventListener("change", closeMenu);
</script>
