---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import { blogPosts } from "@/data/blogPosts";
import { business, breadcrumbs } from "@/data/business";
export function getStaticPaths() {
  return blogPosts.map((post) => ({ params: { slug: post.slug } }));
}
const post = blogPosts.find((p) => p.slug === Astro.params.slug)!;
const schema = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: post.title,
  description: post.metaDescription,
  author: {
    "@type": "Organization",
    name: business.name,
    "@id": `${business.url}/#business`,
  },
  publisher: { "@id": `${business.url}/#business` },
  dateModified: post.modifiedDate,
  image: `${business.url}/social-card.png`,
  mainEntityOfPage: `${business.url}/blog/${post.slug}`,
};
---

<Layout
  title={post.metaTitle}
  description={post.metaDescription}
  jsonLd={[
    schema,
    breadcrumbs([
      ["Planning guide", "/blog"],
      ["Renovation budgets", `/blog/${post.slug}`],
    ]),
  ]}
>
  <article>
    <header class="page-hero">
      <div class="container-main">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/blog">Planning guide</a>
        </nav><p class="eyebrow">{post.category} · {post.readTime}</p><h1>
          {post.title}
        </h1><p class="lead">{post.excerpt}</p><p
          class="mt-6 text-xs text-gray-600"
        >
          By {post.author} · Updated <time datetime={post.modifiedDate}
            >{
              new Date(post.modifiedDate + "T12:00:00Z").toLocaleDateString(
                "en-US",
                {
                  month: "long",
                  day: "numeric",
                  year: "numeric",
                  timeZone: "America/Chicago",
                },
              )
            }</time>
        </p>
      </div>
    </header>
    <div class="section-padding">
      <div class="container-main">
        <div class="article-width article-body">
          {
            post.sections.map((section) => (
              <section>
                <h2>{section.heading}</h2>
                {section.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
                {section.list && (
                  <ul>
                    {section.list.map((item) => (
                      <li>{item}</li>
                    ))}
                  </ul>
                )}
              </section>
            ))
          }
          <aside class="side-note">
            <h2>Want to talk through your scope?</h2><p>
              Start with the property location, the units or spaces that need
              work, and your preferred timing.
            </p><a
              class="text-link"
              href={business.phoneHref}
              data-call-source="guide">Call {business.phone} →</a
            ><div class="related-links">
              <a href="/services/full-gut-rehab">Full gut rehabs</a><a
                href="/services/unit-interior-renovation"
                >Unit interior renovation</a
              ><a href="/services/value-add-programs"
                >Phased renovation programs</a>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </article>
  <CTABanner />
</Layout>
