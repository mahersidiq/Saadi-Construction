---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import kitchen from "@/assets/images/saadi-kitchen-renovation-houston-1.jpg";
import Icon from "@/components/Icon.astro";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import { blogPosts } from "@/data/blogPosts";
import { breadcrumbs } from "@/data/business";
---

<Layout
  title="Apartment Renovation Planning Guide | Multifamily Rehab Specialists"
  description="Practical renovation planning for Houston apartment owners: defining the scope, comparing bids, budgeting for repairs, and planning around residents."
  jsonLd={breadcrumbs([["Planning guide", "/blog"]])}
>
  <section class="page-hero">
    <div class="container-main">
      <p class="eyebrow">Before the work starts</p><h1>
        Better questions.<br /><em>A clearer renovation plan.</em>
      </h1><p class="lead">
        Practical reading for apartment owners and property managers. Start with
        the scope and budget.
      </p>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main">
      {
        blogPosts.map((post) => (
          <article class="article-card">
            <>
              <Image
                src={kitchen}
                alt="Apartment kitchen layout and finish reference"
                widths={[480, 800]}
                sizes="(max-width: 767px) 90vw, 45vw"
                format="webp"
                loading="lazy"
              />
              <div>
                <>
                  <p class="eyebrow">
                    {post.category} · {post.readTime}
                  </p>
                  <h2>
                    <a href={`/blog/${post.slug}`}>{post.title}</a>
                  </h2>
                  <p>{post.excerpt}</p>
                  <a class="text-link" href={`/blog/${post.slug}`}>
                    Read the budgeting guide
                    <Icon />
                  </a>
                </>
              </div>
            </>
          </article>
        ))
      }
    </div>
  </section>
  <CTABanner />
</Layout>
