---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import Hero from "@/components/sections/home/Hero.astro";
import ServicesGrid from "@/components/sections/home/ServicesGrid.astro";
import WhySaadi from "@/components/sections/home/WhySaadi.astro";
import Process from "@/components/sections/home/Process.astro";
import ServiceAreas from "@/components/sections/home/ServiceAreas.astro";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import Faq from "@/components/Faq.astro";
const faqs = [
  {
    question: "Can we start with a few units?",
    answer:
      "Tell us how many apartments are available and what you want to change. A smaller initial phase can help establish the scope, finish selections, and handoff process before you plan a larger rollout. Availability and scheduling are discussed for each property.",
  },
  {
    question: "Do I need a finished scope before I call?",
    answer:
      "No. Start with the property location, the work you have in mind, and whether the units are occupied or vacant. Photos, a floor plan, or an existing bid are useful if you have them, but you do not need all three to start a conversation.",
  },
  {
    question: "Can renovation work be phased around residents?",
    answer:
      "The plan depends on the work. Shared-space improvements and some interior upgrades can be phased, while a full gut rehab usually needs a vacant unit. Access, resident notices, utility interruptions, and safe work areas need to be agreed before work starts.",
  },
  {
    question: "How much will my apartment renovation cost?",
    answer:
      "A useful price needs a defined scope. Unit condition, floor plan, finish choices, repairs behind the walls, and the number of units all affect the budget. Call to discuss your property rather than relying on a generic per-unit number.",
  },
];
---

<Layout
  title="Houston Apartment Renovation | Multifamily Rehab Specialists"
  description="Apartment renovations for Houston property owners and managers. Unit interiors, full gut rehabs, amenities, and exterior improvements. Call (832) 360-3804."
>
  <Hero />
  <div class="scope-strip">
    <div class="container-main">
      <span>Built around apartment communities</span><span>Unit interiors</span
      ><span>Full rehabs</span><span>Property-wide improvements</span>
    </div>
  </div>
  <ServicesGrid /><WhySaadi /><Process /><ServiceAreas /><Faq
    items={faqs}
    title="A few things you might be wondering."
    eyebrow="Before you call"
  /><CTABanner />
</Layout>
