---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import { allServices } from "@/data/services";
import { business, breadcrumbs } from "@/data/business";
const list = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  name: "Apartment renovation services",
  itemListElement: allServices.map((service, i) => ({
    "@type": "ListItem",
    position: i + 1,
    name: service.name,
    url: `${business.url}/services/${service.slug}`,
  })),
};
---

<Layout
  title="Apartment Renovation Services in Houston | Multifamily Rehab Specialists"
  description="Explore apartment interior renovations, full gut rehabs, amenities, exterior improvements, and phased renovation programs in Greater Houston."
  jsonLd={[list, breadcrumbs([["Services", "/services"]])]}
>
  <section class="page-hero">
    <div class="container-main">
      <p class="eyebrow">Houston apartment renovation services</p><h1>
        A single unit.<br />Or the bigger picture.<br /><em
          >Start with the right scope.</em>
      </h1><p class="lead">
        Choose the work your property needs, from a focused interior update to a
        renovation across the community.
      </p>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main service-list">
      {
        allServices.map((service, i) => (
          <a href={`/services/${service.slug}`}>
            <>
              <span class="eyebrow">
                0{i + 1} / {service.category}
              </span>
              <h2>{service.name}</h2>
              <p>{service.description}</p>
              <span class="text-link">
                What to include in the scope
                <Icon />
              </span>
            </>
          </a>
        ))
      }
    </div>
  </section>
  <CTABanner />
</Layout>
