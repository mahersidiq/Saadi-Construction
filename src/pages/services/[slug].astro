---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import Faq from "@/components/Faq.astro";
import Icon from "@/components/Icon.astro";
import { allServices } from "@/data/services";
import { serviceDetails } from "@/data/serviceDetails";
import { business, breadcrumbs } from "@/data/business";
export function getStaticPaths() {
  return allServices.map((service) => ({ params: { slug: service.slug } }));
}
const service = allServices.find((s) => s.slug === Astro.params.slug)!;
const detail = serviceDetails[service.slug];
const serviceSchema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: detail.title,
  description: detail.subheadline,
  provider: { "@id": `${business.url}/#business` },
  areaServed: { "@type": "Place", name: "Greater Houston, Texas" },
  url: `${business.url}/services/${service.slug}`,
};
const related = allServices.filter((s) => s.slug !== service.slug).slice(0, 3);
---

<Layout
  title={`${detail.title} | Multifamily Rehab Specialists`}
  description={detail.subheadline +
    " Discuss your property with Multifamily Rehab Specialists. Call (832) 360-3804."}
  jsonLd={[
    serviceSchema,
    breadcrumbs([
      ["Services", "/services"],
      [service.name, `/services/${service.slug}`],
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/services">Services</a><span
          >/</span
        ><span>{service.name}</span>
      </nav>
      <p class="eyebrow">{service.category} · Greater Houston</p><h1>
        {detail.title}
      </h1><p class="lead">{detail.subheadline}</p>
      <div class="hero-actions">
        <a
          class="btn-primary"
          href={business.phoneHref}
          data-call-source="service"
          ><Icon name="phone" />Talk about your property</a
        ><a class="text-link" href="/contact#project-inquiry"
          >Send the details<Icon /></a>
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main service-detail-grid">
      <div>
        <p class="eyebrow">Understand the scope</p><h2>
          What the work involves.
        </h2><p>{detail.whatIsIt}</p><h3 class="mt-10">
          Work to consider in your scope
        </h3><ul class="plain-list detail-checklist">
          {detail.includes.map((item) => <li>{item}</li>)}
        </ul><p class="text-sm">
          The final scope, exclusions, and any permit or specialist requirements
          are agreed for your property.
        </p>
      </div><aside class="side-note">
        <h2>Before we price it.</h2><ul>
          {detail.planning.map((item) => <li>{item}</li>)}
        </ul><h3 class="mt-8">When this scope makes sense</h3><p>
          {detail.bestFor}
        </p><a class="text-link" href="/projects"
          >Explore renovation scope ideas<Icon /></a>
      </aside>
    </div>
  </section>
  <Faq items={detail.faqs} />
  <section class="section-padding areas-section">
    <div class="container-main">
      <p class="eyebrow">Connected work</p><h2>
        What else is on the list?
      </h2><div class="related-links">
        {related.map((s) => <a href={`/services/${s.slug}`}>{s.name} →</a>)}
      </div>
    </div>
  </section>
  <CTABanner />
</Layout>
