---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import kitchen from "@/assets/images/saadi-kitchen-renovation-houston-1.jpg";
import bathroom from "@/assets/images/saadi-bathroom-double-vanity-houston-1.jpg";
import clubhouse from "@/assets/images/saadi-clubhouse-renovation-houston-1.jpg";
import framing from "@/assets/images/saadi-multifamily-framing-houston-1.jpg";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import Icon from "@/components/Icon.astro";
import { breadcrumbs } from "@/data/business";
const scopes = [
  {
    image: kitchen,
    title: "A kitchen that fits the unit.",
    alt: "Kitchen finish reference with an island and dark lower cabinets",
    text: "Start with the layout, cabinet condition, appliance sizes, and the flooring transition. Decide what stays before choosing what replaces it.",
    href: "/services/unit-interior-renovation",
    link: "Explore interior renovation",
  },
  {
    image: bathroom,
    title: "A bathroom built for daily use.",
    alt: "Bathroom finish reference showing vanities, mirrors, and lighting",
    text: "Look at moisture, ventilation, surfaces, and fixture condition together. New finishes should follow any repairs that need to happen underneath.",
    href: "/services/unit-interior-renovation",
    link: "Plan the interior scope",
  },
  {
    image: clubhouse,
    title: "Shared space with a purpose.",
    alt: "Common-area reference showing a lounge and open seating",
    text: "Think through how the room is used, what needs to stay open, and which finishes the maintenance team can look after.",
    href: "/services/common-area-amenity-renovation",
    link: "Explore common area work",
  },
  {
    image: framing,
    title: "The work before the finishes.",
    alt: "Construction framing reference with exposed timber",
    text: "A deeper rebuild starts with existing conditions, repair needs, and the right trade sequence. Settle those decisions before committing to the finish package.",
    href: "/services/full-gut-rehab",
    link: "Understand full gut rehabs",
  },
];
---

<Layout
  title="Renovation Scope Ideas | Multifamily Rehab Specialists"
  description="Explore apartment kitchen, bathroom, common-area, and full-rehab scope considerations before planning your Houston multifamily renovation."
  jsonLd={breadcrumbs([["Scope ideas", "/projects"]])}
>
  <section class="page-hero">
    <div class="container-main">
      <p class="eyebrow">Spaces &amp; scope</p><h1>
        Start with the space.<br /><em>Then work out the details.</em>
      </h1><p class="lead">
        Use these visual references to think through your renovation. They
        illustrate types of work and finish choices, rather than named project
        case studies.
      </p>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main scope-gallery">
      {
        scopes.map((scope) => (
          <figure>
            <>
              <Image
                src={scope.image}
                alt={scope.alt}
                widths={[480, 800, 1100]}
                sizes="(max-width: 767px) 90vw, 45vw"
                format="webp"
                loading="lazy"
              />
              <figcaption>
                <>
                  <h2>{scope.title}</h2>
                  <p>{scope.text}</p>
                  <a class="text-link" href={scope.href}>
                    {scope.link}
                    <Icon />
                  </a>
                </>
              </figcaption>
            </>
          </figure>
        ))
      }
    </div>
  </section>
  <CTABanner />
</Layout>
