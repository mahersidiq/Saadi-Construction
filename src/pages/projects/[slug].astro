---
// Preserve old example links without presenting invented projects as real work.
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
const oldExamples = Array.from(
  { length: 6 },
  (_, i) => `example-project-${i + 1}`,
);
if (oldExamples.includes(Astro.params.slug || ""))
  return Astro.redirect("/projects", 301);
Astro.response.status = 404;
---

<Layout
  title="Page Not Found | Multifamily Rehab Specialists"
  description="This project page is not available. Explore renovation services or call to discuss your Houston apartment property."
  noindex
>
  <section class="page-hero">
    <div class="container-main">
      <p class="eyebrow">404 · Page not found</p><h1>
        Let’s find the right place.
      </h1><p class="lead">
        This project page isn’t available. Explore our services or talk with us
        about the work you have in mind.
      </p><div class="hero-actions">
        <a class="btn-primary" href="/services">Explore renovation services</a
        ><a class="text-link" href="/contact">Contact us →</a>
      </div>
    </div>
  </section>
</Layout>
