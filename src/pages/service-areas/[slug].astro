---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import Icon from "@/components/Icon.astro";
import { serviceAreas } from "@/data/serviceAreas";
import { allServices } from "@/data/services";
import { business, breadcrumbs } from "@/data/business";
export function getStaticPaths() {
  return serviceAreas.map((area) => ({ params: { slug: area.slug } }));
}
const area = serviceAreas.find((a) => a.slug === Astro.params.slug)!;
const nearby = area.nearbyAreas
  .map((slug) => serviceAreas.find((a) => a.slug === slug))
  .filter(Boolean);
const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  name: `Apartment renovation in ${area.name}, TX`,
  provider: { "@id": `${business.url}/#business` },
  areaServed: { "@type": "City", name: area.name },
  url: `${business.url}/service-areas/${area.slug}`,
};
---

<Layout
  title={`Apartment Renovation in ${area.name}, TX | Multifamily Rehab Specialists`}
  description={`Apartment interiors, full gut rehabs, amenities, and exterior improvements in ${area.name}, Texas. Call (832) 360-3804 to discuss your property.`}
  jsonLd={[
    schema,
    breadcrumbs([
      ["Service areas", "/service-areas"],
      [area.name, `/service-areas/${area.slug}`],
    ]),
  ]}
>
  <section class="page-hero">
    <div class="container-main">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><a href="/service-areas"
          >Service areas</a
        ><span>/</span><span>{area.name}</span>
      </nav><p class="eyebrow">
        {area.county}
        {area.county.includes("/") ? "counties" : "County"} · Texas
      </p><h1>Apartment renovation<br /><em>in {area.name}.</em></h1><p
        class="lead"
      >
        Unit interiors, deeper rehabs, and property-wide work. Let’s talk about
        the scope your community needs.
      </p><div class="hero-actions">
        <a class="btn-primary" href={business.phoneHref} data-call-source="area"
          ><Icon name="phone" />Call {business.phone}</a>
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main content-grid">
      <div class="content-copy">
        <p class="eyebrow">Start with the property</p><h2>
          A plan for your {area.name} community.
        </h2><p>{area.localContent}</p><p>{area.planningNote}</p><a
          class="text-link mt-8"
          href="/blog/apartment-renovation-cost-houston"
          >What to include in your renovation budget<Icon /></a>
      </div><aside class="side-note">
        <h3>Bring these to the first conversation</h3><ul>
          <li>Property location and main areas of concern</li><li>
            Unit count and floor plans, if available
          </li><li>Vacancy, access, and preferred timing</li><li>
            Photos, maintenance notes, or an existing scope
          </li>
        </ul>
      </aside>
    </div>
  </section>
  <section class="section-padding areas-section">
    <div class="container-main">
      <div class="section-heading">
        <div>
          <p class="eyebrow">Choose the work</p><h2>
            Renovation services in {area.name}.
          </h2>
        </div>
      </div><div class="service-list">
        {
          allServices.map((service) => (
            <a href={`/services/${service.slug}`}>
              <>
                <h3>{service.name}</h3>
                <p>{service.description}</p>
                <span class="text-link">
                  Explore this scope
                  <Icon />
                </span>
              </>
            </a>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main">
      <p class="eyebrow">Nearby communities</p><h2>
        Also working across the metro.
      </h2><div class="related-links">
        {nearby.map((a) => <a href={`/service-areas/${a.slug}`}>{a.name} →</a>)}
      </div>
    </div>
  </section>
  <CTABanner />
</Layout>
