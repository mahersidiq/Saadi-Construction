---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import Icon from "@/components/Icon.astro";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import { serviceAreas } from "@/data/serviceAreas";
import { breadcrumbs } from "@/data/business";
---

<Layout
  title="Greater Houston Service Areas | Multifamily Rehab Specialists"
  description="Apartment renovation in Houston, Katy, Sugar Land, Pearland, The Woodlands, and surrounding communities. Call to discuss your property's location and scope."
  jsonLd={breadcrumbs([["Service areas", "/service-areas"]])}
>
  <section class="page-hero">
    <div class="container-main">
      <p class="eyebrow">Our part of Texas</p><h1>
        Apartment renovations<br /><em>across Greater Houston.</em>
      </h1><p class="lead">
        Based in Houston, working with apartment owners and property managers
        across the metro. Find your area below, or call to discuss a property
        further out.
      </p>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main area-directory">
      {
        serviceAreas.map((area) => (
          <a href={`/service-areas/${area.slug}`}>
            <>
              <div>
                <>
                  <h2>{area.name}</h2>
                  <p>
                    {area.county}{" "}
                    {area.county.includes("/") ? "counties" : "County"}
                  </p>
                </>
              </div>
              <Icon />
            </>
          </a>
        ))
      }
    </div>
  </section>
  <CTABanner />
</Layout>
