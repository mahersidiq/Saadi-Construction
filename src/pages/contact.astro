---
// Email availability must be read at request time, including after a deployment.
export const prerender = false;
import Layout from "@/layouts/Layout.astro";
import ContactForm from "@/islands/ContactForm.jsx";
import Icon from "@/components/Icon.astro";
import { business, breadcrumbs } from "@/data/business";
const deliveryAvailable = Boolean(
  import.meta.env.RESEND_API_KEY || process.env.RESEND_API_KEY,
);
---

<Layout
  title="Talk About Your Property | Multifamily Rehab Specialists"
  description="Call (832) 360-3804 to discuss your Houston apartment renovation. Tell us the property location, scope, and timeline. No finished scope required."
  jsonLd={breadcrumbs([["Contact", "/contact"]])}
>
  <section class="page-hero">
    <div class="container-main">
      <p class="eyebrow">Let’s start with your property</p><h1>
        No polished brief needed.<br /><em>Just tell us what needs work.</em>
      </h1><p class="lead">
        A few units, a full rehab, or a property-wide plan. Call and tell us
        where you are in the process.
      </p>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main contact-layout">
      <div class="contact-intro">
        <p class="eyebrow">The most direct way to reach us</p><h2>
          Let’s talk it through.
        </h2><a
          class="direct-phone"
          href={business.phoneHref}
          data-call-source="contact"><Icon name="phone" />{business.phone}</a
        ><p>
          If you reach voicemail, leave your name, number, and property location
          so we can return your call with some context.
        </p><a class="contact-email" href={`mailto:${business.email}`}
          >{business.email}</a
        ><div class="side-note">
          <h3>Useful to have. Not required to call.</h3><ul>
            <li>The property address or neighborhood</li><li>
              How many units or spaces need work
            </li><li>Whether the units are occupied or vacant</li><li>
              Your ideal start date and main concerns
            </li>
          </ul>
        </div>
      </div>
      <div class="form-panel" id="project-inquiry">
        <h2>Prefer to send the details?</h2><p>
          Keep it simple. The basics are enough to start.
        </p><ContactForm
          client:load
          deliveryAvailable={deliveryAvailable}
        /><noscript
          ><p>
            To send an online request, enable JavaScript. You can also <a
              href={business.phoneHref}>call {business.phone}</a
            > or <a href={`mailto:${business.email}`}
              >email your project details</a
            >.
          </p></noscript>
      </div>
    </div>
  </section>
</Layout>
