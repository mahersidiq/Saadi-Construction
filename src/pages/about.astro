---
export const prerender = true;
import Layout from "@/layouts/Layout.astro";
import { Image } from "astro:assets";
import kitchen from "@/assets/images/saadi-kitchen-renovation-houston-1.jpg";
import CTABanner from "@/components/sections/home/CTABanner.astro";
import Process from "@/components/sections/home/Process.astro";
import { breadcrumbs } from "@/data/business";
---

<Layout
  title="Our Approach | Multifamily Rehab Specialists, Houston"
  description="Apartment renovation starts with the property: its condition, residents, access, and budget. Get to know the approach at Multifamily Rehab Specialists."
  jsonLd={breadcrumbs([["Our approach", "/about"]])}
>
  <section class="page-hero">
    <div class="container-main">
      <p class="eyebrow">Multifamily Rehab Specialists · Houston, Texas</p><h1>
        Less sales pitch.<br /><em>More about the work.</em>
      </h1><p class="lead">
        Apartment renovations have enough moving parts. The conversation with
        your contractor should make them easier to understand.
      </p>
    </div>
  </section>
  <section class="section-padding">
    <div class="container-main content-grid">
      <div class="content-copy">
        <p class="eyebrow">What we’re here to do</p><h2>
          Help you make the right call<br />for your property.
        </h2><p>
          Multifamily Rehab Specialists works with apartment owners and property
          managers in Greater Houston on unit interiors, full rehabs, and
          improvements across the community.
        </p><p>
          A vacant unit with worn finishes needs a different plan from a
          building with hidden damage. A clubhouse renovation has different
          access needs from an occupied apartment. The useful questions come
          before the quote.
        </p><p>
          What can stay? What needs replacing? Who needs access, and when? Which
          decisions have to be made before the work starts? Those are the
          details we want to work through with you.
        </p>
      </div>
      <div>
        <Image
          class="content-photo"
          src={kitchen}
          alt="Kitchen layout with an island and adjoining living space"
          widths={[480, 800]}
          sizes="(max-width: 767px) 90vw, 40vw"
          format="webp"
          loading="lazy"
        />
      </div>
    </div>
  </section>
  <section class="section-padding areas-section">
    <div class="container-main content-grid">
      <div>
        <p class="eyebrow">Practical things that matter</p><h2>
          A good working relationship<br />starts with clarity.
        </h2>
      </div><div class="content-copy">
        <ul class="plain-list">
          <li>
            A written scope that makes inclusions and exclusions clear.
          </li><li>
            Finish selections and material responsibilities agreed in advance.
          </li><li>
            A realistic sequence that considers access and residents.
          </li><li>A process for pricing and approving changes.</li><li>
            A punch list and an agreed standard for handoff.
          </li>
        </ul><p>
          These are the points to cover before committing to a renovation. Bring
          your questions. We’ll talk through them.
        </p>
      </div>
    </div>
  </section>
  <Process /><CTABanner />
</Layout>
